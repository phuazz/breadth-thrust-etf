# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Data caches (raw vendor downloads + bulk price caches — not checked in)
data/raw_ishares/
data/prices_cache.parquet
data/prices_cache/
data/prices_cache_*.parquet
data/*_ohlc_cache.parquet
data/spy_close_cache.parquet
data/asset_class_prices_cache.parquet
data/thematic_prices_cache.parquet
# Scanner price cache: ~7MB of raw vendor OHLCV for 54 instruments over 10y,
# rebuilt incrementally by run_scanner.py. The scanner's OUTPUT
# (scanner_latest.json, ~65KB) and its accruing NAV/shares-outstanding
# snapshots ARE committed — the latter cannot be refetched, since yfinance
# exposes no history for those fields.
data/scanner_prices_cache.parquet

# Weekly factsheet dated archives — only factsheet_latest.pdf is committed
# for the stable Pages link. Dated copies (factsheet_YYYY-MM-DD.pdf) are
# built per-run for the email attachment but kept out of git to avoid
# repo bloat (~13MB/year accumulation).
docs/factsheet_20*.pdf

# Email body HTML — rebuilt per workflow run, not for the repo
docs/email_body.html

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code local config (preview launch settings, worktrees)
.claude/
# Norgate vendor pulls — licence: never committed (trailing comments are not
# supported in gitignore patterns; keep this pattern on its own line)
data_local/
# Scheduled-refresh run logs (scripts/scheduled_refresh.py)
logs/
